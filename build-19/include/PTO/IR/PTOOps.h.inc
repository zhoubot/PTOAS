          if (auto as = ::mlir::dyn_cast<::mlir::pto::AddressSpaceAttr>(ms))
            return as.getAddressSpace() == ::mlir::pto::AddressSpace::ACC;
        }
        return false;
      }
      return false;
    };
    if (isAcc(getSrc().getType()))
      return ::mlir::pto::PIPE::PIPE_FIX;
    return ::mlir::pto::PIPE::PIPE_MTE3;
  }
